# --- Project commands ---
# The repository is at specification stage: there is no Cargo.toml and no
# source tree yet, so no command can be detected. Leave these empty until the
# first implementation RFC adds a crate. kaizen check skips empty commands.
# Rust, once a crate exists:
#   KZ_TEST_CMD="cargo test"; KZ_LINT_CMD="cargo clippy --all-targets -- -D warnings"; KZ_FMT_CMD="cargo fmt --check"
KZ_TEST_CMD=""
KZ_LINT_CMD=""
KZ_FMT_CMD=""

# Command printing ONLY a number: coverage percentage. Empty = not measured.
KZ_COVERAGE_CMD=""
# Command printing ONLY a number: lint warning count. Empty = not measured.
KZ_WARNINGS_CMD=""

# --- General ---
KZ_DEFAULT_BRANCH="main"
KZ_DRAFTS_DIR="docs/kaizen/pr-drafts"
KZ_SRC_GLOBS="src lib app pkg crates"

# --- POLICIES (1 = active, 0 = inactive). Mirrors CLAUDE.md section 7. ---
KZ_POLICY_COMMIT_MAX=256
KZ_POLICY_NO_EMOJI=1
KZ_POLICY_NO_AI_ATTRIBUTION=1
KZ_POLICY_BRANCH_PREFIXES_BLOCKED=""
