# Kaizen loop configuration. Set by the repository owner.
# claude | codex | opencode | agy | custom
KL_AGENT="opencode"
# 1 = propose only, 2 = auto-merge low risk, 3 = also verified bugfixes
KL_AUTONOMY=1

KL_LOOPS="dev ops sweep research product"
KL_INTERVAL_SEC=3600
KL_MAX_TURNS=40
KL_TIMEOUT_SEC=1800
KL_MAX_RUNS_PER_DAY=24
KL_MAX_CONSEC_FAILS=3

# Command used to prepare dependencies in the temporary clone.
# No Cargo project for the product exists yet; leave empty.
KL_SETUP_CMD=""

# Only used when KL_AGENT=claude.
KL_CLAUDE_ALLOWED="Read,Edit,Write,Glob,Grep,Bash(git add:*),Bash(git commit:*),Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(scripts/kaizen:*),Bash(gh issue:*)"
# Only used when KL_AGENT=custom. The variable $KL_PROMPT holds the prompt.
KL_CUSTOM_CMD=""

# Risk classification (space-separated globs).
KL_PROTECTED_GLOBS=".github/* .githooks/* .kaizen/* scripts/kaizen* docs/kaizen/loop/* CODEOWNERS AGENTS.md CLAUDE.md GEMINI.md opencode.json .claude/* .agents/* .opencode/* tools/kaizen-insights/* *auth* *billing* *payment* *secret* *.env* migrations/* infra/* terraform/* Dockerfile*"
KL_LOWRISK_GLOBS="docs/* *.md"
KL_TEST_GLOBS="tests/* test/* *_test.* *.test.* *.spec.* *_spec.*"
KL_LOWRISK_MAX_LINES=150
