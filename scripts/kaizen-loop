#!/usr/bin/env bash
# kaizen-loop: external orchestrator for the continuous improvement cycle.
# The agent never pushes or opens PRs: this script does so after validation.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"; cd "$ROOT"
[ -f .kaizen/config.env ] && . .kaizen/config.env
[ -f .kaizen/loop/loop.env ] && . .kaizen/loop/loop.env
: "${KL_AGENT:=claude}" "${KL_AUTONOMY:=1}" "${KL_LOOPS:=dev ops sweep}" "${KL_INTERVAL_SEC:=3600}"
: "${KL_MAX_TURNS:=40}" "${KL_TIMEOUT_SEC:=1800}" "${KL_MAX_RUNS_PER_DAY:=24}" "${KL_MAX_CONSEC_FAILS:=3}"
: "${KL_LOWRISK_MAX_LINES:=150}" "${KL_SETUP_CMD:=}" "${KL_DRY_RUN:=0}"
: "${KL_CLAUDE_ALLOWED:=Read,Edit,Write,Glob,Grep,Bash(git add:*),Bash(git commit:*),Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(scripts/kaizen:*),Bash(gh issue:*)}"
BASE="${KZ_DEFAULT_BRANCH:-main}"; DRAFTS="${KZ_DRAFTS_DIR:-docs/kaizen/pr-drafts}"
STATE=".kaizen/loop/state"; PAUSE=".kaizen/loop/PAUSE"; mkdir -p "$STATE"
IN_CI=0; [ "${GITHUB_ACTIONS:-}" = "true" ] && IN_CI=1
TO=""
if command -v timeout >/dev/null 2>&1; then TO="timeout $KL_TIMEOUT_SEC"
elif command -v gtimeout >/dev/null 2>&1; then TO="gtimeout $KL_TIMEOUT_SEC"; fi

log() { echo "$(date -u +%FT%TZ) $*" | tee -a "$STATE/loop.log" >&2; }

is_paused() {
  [ -e "$PAUSE" ] && return 0
  [ $IN_CI = 1 ] && [ "$(gh variable get KAIZEN_PAUSED 2>/dev/null || true)" = "1" ] && return 0
  return 1
}
trip() {
  touch "$PAUSE"
  [ $IN_CI = 1 ] && gh variable set KAIZEN_PAUSED --body 1 >/dev/null 2>&1
  command -v gh >/dev/null 2>&1 && gh issue create --label needs-human \
    --title "[kaizen] Loop paused after consecutive failures" \
    --body "The circuit breaker paused the loop. Check the orchestrator log and clear the pause with: scripts/kaizen-loop resume" >/dev/null 2>&1
  return 0
}
consec_fails() {
  if [ $IN_CI = 1 ]; then
    gh run list --workflow kaizen-loop.yml --status completed --limit "$KL_MAX_CONSEC_FAILS" \
      --json conclusion --jq '[.[]|select(.conclusion=="failure")]|length' 2>/dev/null || echo 0
  else cat "$STATE/fails" 2>/dev/null || echo 0; fi
}
add_fail()   { [ $IN_CI = 1 ] || echo $(( $(cat "$STATE/fails" 2>/dev/null || echo 0) + 1 )) > "$STATE/fails"; }
reset_fails(){ [ $IN_CI = 1 ] || echo 0 > "$STATE/fails"; }

preflight() {
  is_paused && { log "PAUSE active: not running"; return 1; }
  local today runs; today="$(date -u +%Y%m%d)"; runs="$(cat "$STATE/runs-$today" 2>/dev/null || echo 0)"
  [ "$runs" -ge "$KL_MAX_RUNS_PER_DAY" ] && { log "daily budget exhausted ($runs)"; return 1; }
  if [ "$(consec_fails)" -ge "$KL_MAX_CONSEC_FAILS" ]; then log "CIRCUIT BREAKER: consecutive failures"; trip; return 1; fi
  echo $((runs + 1)) > "$STATE/runs-$today"; return 0
}

# classify <base-ref> <head-ref> [loop] -> needs-human | low-risk | review
classify() {
  local b="$1" h="$2" loop="${3:-}" f g lines tests=0 low=1 P L T
  read -ra P <<< "${KL_PROTECTED_GLOBS:-}"; read -ra L <<< "${KL_LOWRISK_GLOBS:-}"; read -ra T <<< "${KL_TEST_GLOBS:-}"
  lines="$(git diff --numstat "$b" "$h" | awk '{s+=$1+$2} END{print s+0}')"
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    for g in "${P[@]}"; do [[ "$f" == $g ]] && { echo needs-human; return; }; done
    local isdoc=0 istest=0
    for g in "${L[@]}"; do [[ "$f" == $g ]] && isdoc=1; done
    for g in "${T[@]}"; do [[ "$f" == $g ]] && istest=1; done
    [ $istest = 1 ] && tests=1
    [ $isdoc = 0 ] && [ $istest = 0 ] && low=0
  done < <(git diff --name-only "$b" "$h")
  if [ "$lines" -gt "$KL_LOWRISK_MAX_LINES" ]; then echo review
  elif [ $low = 1 ]; then echo low-risk
  elif [ "$KL_AUTONOMY" -ge 3 ] && [ "$loop" = "ops" ] && [ $tests = 1 ]; then echo low-risk
  else echo review; fi
}

run_agent() { # $1 workdir  $2 prompt  (runs in a subshell)
  local wd="$1" p="$2"; cd "$wd" || return 1
  case "$KL_AGENT" in
    claude)   $TO claude -p "$p" --max-turns "$KL_MAX_TURNS" --permission-mode acceptEdits --allowedTools "$KL_CLAUDE_ALLOWED" ;;
    codex)    $TO codex exec --sandbox workspace-write -C "$wd" "$p" ;;
    opencode) $TO opencode run "$p" ;;
    agy)      $TO agy -p "$p" ;;
    custom)   KL_PROMPT="$p" $TO bash -c "$KL_CUSTOM_CMD" ;;
    *) echo "unknown agent: $KL_AGENT" >&2; return 2 ;;
  esac
}

iterate() {
  local loop="$1" ts br wd url base_sha prompt rc=0 class draft=() title d
  ts="$(date -u +%Y%m%d-%H%M%S)"; br="kaizen/${loop}-${ts}"; d="$DRAFTS/${br//\//-}.md"
  prompt="Run ONE iteration of the '$loop' loop following docs/kaizen/loop/prompts/$loop.md. Branch: $br. Descriptor: $d. Autonomy level: $KL_AUTONOMY. Do not push and do not open a PR."
  if [ "$KL_DRY_RUN" = "1" ]; then log "[dry-run] loop=$loop agent=$KL_AGENT branch=$br"; echo "$prompt"; return 0; fi

  git fetch --quiet origin "$BASE" 2>/dev/null || true
  url="$(git remote get-url origin 2>/dev/null || echo "$ROOT")"
  wd="$(mktemp -d "${TMPDIR:-/tmp}/kaizen-${loop}-XXXXXX")"
  git clone --quiet --local --no-checkout "$ROOT" "$wd" || { log "clone failed"; return 1; }
  ( cd "$wd" || exit 1
    git remote set-url origin "$url"
    if git fetch --quiet origin "$BASE" 2>/dev/null; then git checkout --quiet -b "$br" "origin/$BASE"
    else git checkout --quiet -b "$br" "$(git -C "$ROOT" rev-parse "$BASE")"; fi
    [ -x scripts/kaizen ] && scripts/kaizen init >/dev/null 2>&1
    [ -n "$KL_SETUP_CMD" ] && bash -c "$KL_SETUP_CMD" >"$STATE/setup-$ts.log" 2>&1
    true ) || { log "preparation failed"; rm -rf "$wd"; return 1; }
  base_sha="$(git -C "$wd" rev-parse HEAD)"

  log "iteration: loop=$loop agent=$KL_AGENT branch=$br"
  ( run_agent "$wd" "$prompt" ) >"$STATE/agent-$ts.log" 2>&1 || rc=$?
  cd "$wd" || return 1
  [ -n "$(git status --porcelain)" ] && { git add -A; git commit -q -m "Kaizen $loop: iteration changes"; }

  if [ "$(git rev-list --count "$base_sha..HEAD")" = "0" ]; then
    log "no changes in $loop (rc=$rc)"; cd "$ROOT"; rm -rf "$wd"
    if [ $rc -eq 0 ]; then reset_fails; return 0; else add_fail; return 1; fi
  fi

  class="$(classify "$base_sha" HEAD "$loop")"
  if [ $rc -ne 0 ] || ! scripts/kaizen check >"$STATE/check-$ts.log" 2>&1; then class="failed-gates"; draft=(--draft); fi
  [ "$KL_AUTONOMY" -lt 2 ] && [ "$class" = "low-risk" ] && class="review"

  git push --quiet origin "$br" || { log "push failed"; cd "$ROOT"; add_fail; return 1; }
  title="$(git log -1 --format=%s)"
  local body=(--body "Automated Kaizen iteration ($loop). Risk class: $class.")
  [ -f "$d" ] && body=(--body-file "$d")
  if gh pr create --base "$BASE" --head "$br" --title "$title" "${body[@]}" \
       --label kaizen --label "kaizen:$class" "${draft[@]}" >/dev/null 2>&1; then
    log "PR opened ($class) branch=$br"
  else log "could not open PR; branch $br was pushed"; fi
  cd "$ROOT"; rm -rf "$wd"
  if [ "$class" = "failed-gates" ]; then add_fail; return 1; fi
  reset_fails; return 0
}

cmd_once() {
  preflight || return 0
  local loop="${1:-}" L n
  if [ -z "$loop" ]; then
    read -ra L <<< "$KL_LOOPS"; n="${GITHUB_RUN_NUMBER:-$(cat "$STATE/rot" 2>/dev/null || echo 0)}"
    loop="${L[$((n % ${#L[@]}))]}"; echo $((n + 1)) > "$STATE/rot"
  fi
  iterate "$loop"
}

cmd_daemon() {
  trap 'log "daemon stopped"; exit 0' INT TERM
  while true; do cmd_once || true; sleep $((KL_INTERVAL_SEC + RANDOM % 60)); done
}

cmd_status() {
  echo "pause: $([ -e "$PAUSE" ] && echo YES || echo no) | autonomy: $KL_AUTONOMY | agent: $KL_AGENT"
  echo "consecutive failures: $(consec_fails) | runs today: $(cat "$STATE/runs-$(date -u +%Y%m%d)" 2>/dev/null || echo 0)"
  echo "--- latest journal entries"; ls -1 docs/kaizen/journal 2>/dev/null | tail -5
  echo "--- log"; tail -5 "$STATE/loop.log" 2>/dev/null || true
}

cmd_init() {
  command -v gh >/dev/null 2>&1 || { echo "gh unavailable: create the labels manually"; return 0; }
  local l
  for l in kaizen kaizen:ready kaizen:low-risk kaizen:review kaizen:needs-human kaizen:failed-gates \
           needs-human auto-detected proposal feedback regression-suspect bug; do
    gh label create "$l" --force >/dev/null 2>&1 || true
  done
  mkdir -p docs/kaizen/journal docs/kaizen/research docs/kaizen/proposals docs/kaizen/loop/prompts docs/kaizen/data/insights
  echo "labels and directories ready"
}

case "${1:-help}" in
  once) shift; cmd_once "$@";;
  daemon) cmd_daemon;;
  status) cmd_status;;
  pause) touch "$PAUSE"; [ $IN_CI = 1 ] && gh variable set KAIZEN_PAUSED --body 1; echo "loop paused";;
  resume) rm -f "$PAUSE" "$STATE/fails"; gh variable set KAIZEN_PAUSED --body 0 >/dev/null 2>&1 || true; echo "loop resumed";;
  classify) shift; classify "$@";;
  init) cmd_init;;
  *) cat <<'EOF'
kaizen-loop <command>
  once [loop]            one iteration (rotates over KL_LOOPS if omitted)
  daemon                 iterate continuously with a pause between runs
  status                 state, budget and latest journal entries
  pause | resume         manual brake
  classify <base> <head> [loop]   risk class of a diff
  init                   labels and directories
Useful variables: KL_DRY_RUN=1 (print the plan only), KL_AGENT, KL_AUTONOMY
EOF
   ;;
esac
