{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gravital:fabric-node-manifest:1.0.0",
  "title": "Fabric local node manifest",
  "description": "Local-only node discovery artifact from the fabric-node prototype. Not a control-plane registration contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "node",
    "hardware"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "identity_source",
        "os",
        "arch",
        "hostname"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "identity_source": {
          "type": "string",
          "enum": [
            "machine-id",
            "dbus-machine-id",
            "hostname"
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_count",
        "memory_total_bytes",
        "memory_source",
        "block_devices",
        "network_interfaces"
      ],
      "properties": {
        "cpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "memory_total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "memory_source": {
          "type": "string",
          "enum": [
            "proc-meminfo",
            "unavailable"
          ]
        },
        "block_devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "size_bytes"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "network_interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "mac",
              "state"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mac": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
